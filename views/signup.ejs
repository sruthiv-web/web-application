<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up|WebApp</title>
    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }
        body{
            min-height: 100vh;
            display:flex;
            justify-content: center;
            align-items: center;
            font-family:Arial,sens-serif;
            background: #f5f7fb;

        }
        .signup-container{
            width:100%;
            max-width:460px;
            padding: 20px;
        }
        .signup-card{
            background: white;
            padding: 40px;
            border-radius:16px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.08);
        }
        .brand{
            text-align: center;
            margin-bottom: 30px;
        }
        .brand h1{
            font-size:28px;
            margin-bottom: 8px;
        }
        .brand p{
            color:#6b7280;
            font-size: 14px;
        }
        .form-group{
            margin-bottom: 28px;
        }
        label{
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
        }
        input{
            width:100%;
            padding: 13px 14px;
            border:1px solid #d1d5db;
            border-radius:8px;
            font-size: 15px;
            outline:none;
        }
        input:focus{
            border-color: #2563eb;
        }
        button{
            width:100%;
            padding: 13px;
            border:none;
            border-radius:8px;
            background:#2563eb;
            color:white;
            font-size: 15px;
            font-weight: 600;
            cursor:pointer;
        }
        button:hover{
            background: #1d4ed8;
        }
        #message {
            margin-top: 10px;
            margin-bottom: 10px;
            text-align: center;
            font-size: 14px;
            color: #5f6c8f;
        }
        @media(max-width:480px){
            .signup-card{
                padding:30px 22px;
            }
        }
    </style>
</head>
<body>
    <main class="signup-container">
        <section class="signup-card">
            <div class="brand">
                <h1>Create Account</h1>
                <p>Sign up to get started with WebApp</p>
            </div>
            <form id="signupForm">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="Enter your full name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                </div>
                <div class="form-group">
                    <label for="passord">Password</label>
                    <input type="password" id="password" name="password" placeholder="Create a password" required>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required>
                </div>
                
                <button type="submit">Create Account</button>
            </form>
            <p id="message"></p>
            <p class="login-text">Already have an account?
                <a href="/">Login</a>
            </p>
        </section>
    </main>
    <script src="/js/script.js"></script>
</body>
</html>